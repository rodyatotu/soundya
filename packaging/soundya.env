# soundya settings. After editing:  /etc/init.d/S99soundya restart
# Proxy and «только по слову саундклауд» are set on the web page
# (http://<IP колонки>:8765) and stored in /data/opt/soundya/config.json.

# Port of the web page; 0 turns it off.
SOUNDYA_WEB_PORT=8765

# Name on the local network: the page opens at http://<name>.local:8765
SOUNDYA_NAME=soundya

# ALSA output device.
SOUNDYA_DEVICE=default

export SOUNDYA_WEB_PORT SOUNDYA_DEVICE SOUNDYA_NAME
